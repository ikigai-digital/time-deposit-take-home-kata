<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="001_1-create-time-deposits" author="time-deposit-service">
        <createTable schemaName="public" tableName="time_deposits"
                     remarks="Time deposits of XA Bank customers (README table timeDeposits)">
            <column name="id" type="INT" remarks="Time deposit identifier">
                <constraints primaryKey="true" primaryKeyName="pk_time_deposits" nullable="false"/>
            </column>
            <column name="plan_type" type="VARCHAR(50)" remarks="Interest plan: basic, student or premium">
                <constraints nullable="false"/>
            </column>
            <column name="days" type="INT" remarks="Days since the deposit was opened">
                <constraints nullable="false"/>
            </column>
            <column name="balance" type="DECIMAL(19,2)" remarks="Current balance">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

</databaseChangeLog>
